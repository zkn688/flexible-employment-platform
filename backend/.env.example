SERVER_PORT=8080

DB_URL=jdbc:mysql://your_tidb_host:4000/flexible_employment?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&allowPublicKeyRetrieval=true
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TIMEOUT=1s
REDIS_CACHE_ENABLED=true

FILE_UPLOAD_DIR=E:/keshe/uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_HOURS=24

ALIYUN_OSS_ENABLED=true
ALIYUN_OSS_ENDPOINT=your_oss_endpoint
ALIYUN_OSS_BUCKET_NAME=your_oss_bucket_name
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret

KNIFE4J_ENABLE=true
